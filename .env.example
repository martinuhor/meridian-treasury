# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Privy Auth & Embedded Wallets
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"

# Signed session cookies — required for demo sign-in
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# In-memory demo store. Keep false in production so Postgres is used when
# DATABASE_URL is set. Local/dev still falls back to demo when DATABASE_URL
# is unset — only set true if you intentionally want demo without a DB.
DEMO_MODE="false"

# Blockchain Configuration (Base Mainnet = 8453, Base Sepolia = 84532)
NEXT_PUBLIC_CHAIN_ID="84532"
NEXT_PUBLIC_RPC_URL="https://sepolia.base.org"
NEXT_PUBLIC_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
NEXT_PUBLIC_VAULT_ADDRESS="0x0000000000000000000000000000000000000000"
PROTOCOL_TREASURY_ADDRESS="0xYourProtocolFeeWalletAddress"
